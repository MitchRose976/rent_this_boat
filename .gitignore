# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docs
/docs

# Python virtual environment
.venv/

# Ignore all .venv folders
**/.venv/

*.venv/.gitignore

echo "*" > .venv/.gitignore

# Python cache files
__pycache__/
*.py[cod]
*$py.class
backend/**/__pycache__/

