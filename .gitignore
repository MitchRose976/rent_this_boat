# =============================================================================
# MONOREPO GITIGNORE
# Root-level ignore file for frontend and backend.
# =============================================================================

# =============================================================================
# COMMON
# =============================================================================

.DS_Store
*.log
*.pem

# IDE and editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# =============================================================================
# FRONTEND (Next.js) - frontend/
# =============================================================================

# Dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions

# Build artifacts
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/

# Environment files
frontend/.env*

# Vercel
frontend/.vercel/

# TypeScript generated files
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# =============================================================================
# BACKEND (Python/FastAPI) - backend/
# =============================================================================

# Virtual environments
backend/.venv/
backend/venv/
backend/env/
backend/ENV/

# Python caches and artifacts
backend/__pycache__/
backend/**/__pycache__/
backend/*.py[cod]
backend/**/*.py[cod]
backend/*$py.class
backend/**/*$py.class
backend/*.so
backend/**/*.so

# Python packaging
backend/*.egg-info/
backend/build/
backend/dist/
backend/*.egg

# Testing and type checking
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/.tox/
backend/.mypy_cache/
backend/.dmypy.json
backend/dmypy.json

# Environment files
backend/.env
backend/.env.local

# =============================================================================
# OPTIONAL PROJECT DOCS
# =============================================================================

/docs

